MMDp4 VDD VDD VDD VDD sg13_lv_pmos w=1u l=0.13u ng=1
CCg1 vbg_buf VSS cap_cmim w=19.5e-6 l=19.1e-6
CCg2 vbg_buf VSS cap_cmim w=13.6e-6 l=7.28e-6
.ends
