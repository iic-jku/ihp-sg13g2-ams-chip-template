RRg vbg_int nbg 4.5076k $SUB=VSS $[rppd] w=0.5e-6 l=8.5e-6 b=0
MMN3 nbg nbg VSS VSS sg13_lv_nmos w=2.5u l=0.5u ng=1
MMCn1 VSS vbn_buf VSS VSS sg13_lv_nmos w=40u l=10u ng=5
MMCn2 VSS vbn_buf VSS VSS sg13_lv_nmos w=40u l=10u ng=5
RRf vbg_int vbg_buf 94.929k $SUB=VSS $[rhigh] w=0.5e-6 l=32e-6 b=0
MMCg1 VSS vbg_buf VSS VSS sg13_lv_nmos w=40u l=10u ng=5
MMCg2 VSS vbg_buf VSS VSS sg13_lv_nmos w=40u l=10u ng=5
